{
  "name": "survero-web-sdks",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/web",
    "packages/react",
    "packages/vue",
    "packages/svelte",
    "packages/angular"
  ],
  "scripts": {
    "build": "npm run build -w @survero/web && npm run build -w @survero/react -w @survero/vue -w @survero/svelte -w @survero/angular",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "size": "node scripts/size.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "tsup": "^8.5.0",
    "vitest": "^4.1.12",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "vue": "^3.5.0",
    "svelte": "^5.40.0",
    "@angular/core": "^21.0.0",
    "rxjs": "^7.8.0",
    "@playwright/test": "1.59.1",
    "vite": "^7.1.0"
  }
}
