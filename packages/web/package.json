{
  "name": "@survero/web",
  "version": "0.1.0",
  "description": "Survero for the web: product events, identity and in-app micro-surveys. Works with any framework.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/survero.js",
  "jsdelivr": "./dist/survero.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "keywords": ["survero", "analytics", "events", "surveys", "nps", "feedback", "product-analytics"],
  "scripts": {
    "build": "tsup"
  }
}
